Algoritmo saludo
	Definir nombre, apellido, saludof Como Cadena
	Escribir '=== Bienvenida al sistema ==='
	Escribir 'Ingresa tu primer nombre: 'Sin Saltar
	Leer nombre
	Escribir 'Ingresa tu primer apellido: 'Sin Saltar
	Leer apellido
	saludof <- 'Hola '+nombre+' '+apellido+', un gusto conoceerte'
	Escribir ''
	Escribir saludof
FinAlgoritmo
